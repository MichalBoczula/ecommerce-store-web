{
  "name": "ecommerce-store-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --watch=false --coverage",
    "test:acceptance": "playwright test",
    "test:acceptance:list": "playwright test --list",
    "lint": "ng lint",
    "generate:clients": "bash scripts/generate-clients.sh"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "@angular/animations": "21.2.24",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "21.2.24",
    "@angular/router": "21.2.24",
    "@microsoft/kiota-abstractions": "^1.0.0-preview.103",
    "@microsoft/kiota-http-fetchlibrary": "^1.0.0-preview.103",
    "@microsoft/kiota-serialization-form": "^1.0.0-preview.103",
    "@microsoft/kiota-serialization-json": "^1.0.0-preview.103",
    "@microsoft/kiota-serialization-multipart": "^1.0.0-preview.103",
    "@microsoft/kiota-serialization-text": "^1.0.0-preview.103",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/entity": "^21.0.1",
    "@ngrx/router-store": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@ngrx/store-devtools": "^21.0.1",
    "rxjs": "~7.8.0",
    "swiper": "^12.2.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.24",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@angular/platform-browser-dynamic": "^21.2.24",
    "@playwright/test": "^1.63.0",
    "@types/webpack-env": "^1.18.8",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "21.1.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.47.0",
    "vitest": "^4.1.11"
  }
}
